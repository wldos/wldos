# 域名 / HTTPS / apex→www：由边缘 Nginx 处理（docs/wldos3.0/官网部署/wldos.conf），
# 勿在本文件写 RewriteCond %{HTTPS} 或 301 到 https/http——Nginx 反代到 Apache 时
# Apache 侧 HTTPS 恒为 off，会 301 死循环；目标写 http://www 会与 Nginx 443 互跳。
#
# 爬虫 + 门户 SSR（白名单→Tomcat、其余→Rendertron）：由 Apache vhost 的 <Directory> 配置
#（docs/wldos3.0/官网部署/内网apache/wordpress.conf），勿在此重复 UA→Rendertron。

<IfModule mod_rewrite.c>
RewriteEngine on
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?wldos\.com [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?wldos\.org [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?github.com [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?baidu.com [NC]
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?gitee.com [NC]
RewriteRule \.(jpe?g?|png|gif|ico|pdf|flv|swf|gz|svg|bmp)$ - [NC,F,L]
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine on
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteCond %{REQUEST_URI} \.(js|mjs|css|map|json|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp|txt|xml)$ [NC]
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
</IfModule>
